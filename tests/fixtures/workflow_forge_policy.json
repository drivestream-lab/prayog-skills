{
  "commit_workspace": {
    "validate-requirements": "optional",
    "review-findings": "optional",
    "update-documents": "optional",
    "prd-impact-map": "required",
    "spec-draft": "required",
    "initiative-feasibility": "required",
    "spec-technical-review": "required",
    "spec-implementation-plan": "required",
    "pre-implement": "required",
    "loop-spec": "required",
    "verify": "optional",
    "learning-extract": "optional",
    "ground-spec": "required",
    "purge-initiative-artifacts-app": "required",
    "purge-initiative-artifacts-meta": "required"
  },
  "external_action_authorization": {
    "prd-pr-action": "explicit",
    "prd-merge": "explicit",
    "spec-pr-action": "automated",
    "spec-merge": "explicit",
    "board-tickets-action": "explicit",
    "wave-in-progress-action": "automated",
    "wave-pr-action": "automated",
    "wave-done-action": "automated",
    "initiative-closure-pr-action-app": "automated",
    "initiative-closure-pr-action-meta": "automated"
  },
  "external_action_forge": {
    "prd-pr-action": {
      "action": "open_draft_pr",
      "draft": true,
      "apply_labels": ["impact-map-pending"],
      "requires": ["title", "body_path"]
    },
    "spec-pr-action": {
      "action": "open_draft_pr",
      "draft": true,
      "apply_labels": ["spec-pending"],
      "requires": ["title", "body_path"]
    },
    "board-tickets-action": {
      "action": "create_board_tickets",
      "requires": ["initiative", "plan_path"]
    },
    "wave-in-progress-action": {
      "action": "update_board_status",
      "status": "in_progress",
      "requires": ["ticket"]
    },
    "wave-pr-action": {
      "action": "open_draft_pr",
      "draft": true,
      "apply_labels": [],
      "requires": ["title", "body_path", "head_ref", "base_ref"]
    },
    "wave-done-action": {
      "action": "update_board_status",
      "status": "done",
      "requires": ["ticket"]
    },
    "initiative-closure-pr-action-app": {
      "action": "open_draft_pr",
      "draft": true,
      "apply_labels": [],
      "requires": ["title", "body_path"]
    },
    "initiative-closure-pr-action-meta": {
      "action": "open_draft_pr",
      "draft": true,
      "apply_labels": [],
      "requires": ["title", "body_path"]
    }
  },
  "human_forge_skills": {
    "commit_workspace": "commit-workspace",
    "open_draft_pr": "open-draft-pr",
    "create_board_tickets": "create-board-tickets"
  },
  "forbid_auto_label_suffix": "-lgtm"
}
